    {
      "type": "row",
      "title": "Throughput and outcomes",
      "collapsed": false,
      "panels": [],
      "id": 7,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 4
      }
    },
    {
      "type": "timeseries",
      "title": "Job runs by result",
      "description": "Job results per interval. A job can fail while the agent run itself succeeded.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "refId": "A",
          "expr": "sum by (cicd_pipeline_task_run_result)(increase(gh_aw_job_duration_seconds_count{gh_aw_workflow_name=~\"$workflow\", gh_aw_job_name=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{cicd_pipeline_task_run_result}}",
          "range": true
