      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "refId": "A",
          "expr": "sum(increase(gen_ai_client_token_usage_total{gh_aw_workflow_name=~\"$workflow\", gh_aw_job_name=~\"$job\", gh_aw_engine_id=~\"$engine\", gen_ai_token_type=\"input\"}[$__rate_interval]))",
