          "refId": "A",
          "expr": "sum by (gh_aw_workflow_name) (increase(gen_ai_client_token_usage_total{gh_aw_workflow_name=~\"$workflow\", gh_aw_job_name=~\"$job\", gh_aw_engine_id=~\"$engine\", gen_ai_token_type=\"input\"}[$__rate_interval])) * $price_input / 1e6 + sum by (gh_aw_workflow_name) (increase(gen_ai_client_token_usage_total{gh_aw_workflow_name=~\"$workflow\", gh_aw_job_name=~\"$job\", gh_aw_engine_id=~\"$engine\", gen_ai_token_type=\"output\"}[$__rate_interval])) * $price_output / 1e6 + sum by (gh_aw_workflow_name) (increase(gen_ai_client_token_usage_total{gh_aw_workflow_name=~\"$workflow\", gh_aw_job_name=~\"$job\", gh_aw_engine_id=~\"$engine\", gen_ai_token_type=\"input_cache_read\"}[$__rate_interval])) * $price_cache_read / 1e6 + sum by (gh_aw_workflow_name) (increase(gen_ai_client_token_usage_total{gh_aw_workflow_name=~\"$workflow\", gh_aw_job_name=~\"$job\", gh_aw_engine_id=~\"$engine\", gen_ai_token_type=\"input_cache_write\"}[$__rate_interval])) * $price_cache_write / 1e6",
          "legendFormat": "{{gh_aw_workflow_name}}",
          "range": true
