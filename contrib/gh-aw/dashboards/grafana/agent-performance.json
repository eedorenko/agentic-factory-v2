    {
      "type": "timeseries",
      "title": "Tool-call error rate by workflow",
      "description": "Alert: > 20% over 6 hours with at least 20 calls.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
