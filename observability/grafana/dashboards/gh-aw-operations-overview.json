{
  "uid": "gh-aw-operations-overview",
  "title": "gh-aw / Operations Overview",
  "description": "Is the agentic-workflow fleet healthy, slow, and producing work? For on-call and maintainers.",
  "tags": [
    "gh-aw",
    "otel",
    "operations"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "includeAll": false,
        "multi": false,
        "options": []
      },
      {
        "name": "workflow",
        "label": "Workflow",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "definition": "label_values(gh_aw_job_duration_seconds_count, gh_aw_workflow_name)",
        "query": {
          "query": "label_values(gh_aw_job_duration_seconds_count, gh_aw_workflow_name)",
          "refId": "var_workflow",
          "qryType": 1
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "regex": "",
        "hide": 0
      },
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "definition": "label_values(gh_aw_job_duration_seconds_count{gh_aw_workflow_name=~\"$workflow\"}, gh_aw_job_name)",
        "query": {
          "query": "label_values(gh_aw_job_duration_seconds_count{gh_aw_workflow_name=~\"$workflow\"}, gh_aw_job_name)",
          "refId": "var_job",
          "qryType": 1
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "regex": "",
        "hide": 0
      },
      {
        "name": "engine",
        "label": "Engine",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "definition": "label_values(gh_aw_job_duration_seconds_count, gh_aw_engine_id)",
        "query": {
          "query": "label_values(gh_aw_job_duration_seconds_count, gh_aw_engine_id)",
          "refId": "var_engine",
          "qryType": 1
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "regex": "",
        "hide": 0
      },
      {
        "name": "result",
        "label": "Job result",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "definition": "label_values(gh_aw_job_duration_seconds_count, cicd_pipeline_task_run_result)",
        "query": {
          "query": "label_values(gh_aw_job_duration_seconds_count, cicd_pipeline_task_run_result)",
          "refId": "var_result",
          "qryType": 1
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "regex": "",
        "hide": 0
      },
      {
        "name": "gh_repo",
        "label": "GitHub repo (owner/name)",
        "type": "textbox",
        "query": "github/gh-aw",
        "current": {
          "text": "github/gh-aw",
          "value": "github/gh-aw"
        },
        "options": [
          {
            "selected": true,
            "text": "github/gh-aw",
            "value": "github/gh-aw"
          }
        ],
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "GitHub Actions",
      "url": "https://github.com/${gh_repo}/actions",
      "targetBlank": true,
      "type": "link",
      "icon": "external link"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Jobs completed",
      "description": "Question: How many gh-aw jobs finished in the selected range?\nMetrics: Tier A: emitted by gh-aw.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "refId": "A",
          "expr": "sum (increase(gh_aw_job_duration_seconds_count{gh_aw_workflow_name=~\"$workflow\", gh_aw_job_name=~\"$job\", gh_aw_engine_id=~\"$engine\", cicd_pipeline_task_run_result=~\"$result\"}[$__range]))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Failure rate",
      "description": "Question: What share of jobs ended in failure, timeout or cancellation? Shows No data (not 0%) when no jobs ran.\nMetrics: Tier A: emitted by gh-aw.\nIgnores variables: engine, model, result (counters in the ratio do not all carry them).",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "refId": "A",
          "expr": "(sum (increase(gh_aw_job_errors_total{gh_aw_workflow_name=~\"$workflow\", gh_aw_job_name=~\"$job\"}[$__range]))) / ((sum (increase(gh_aw_job_duration_seconds_count{gh_aw_workflow_name=~\"$workflow\", gh_aw_job_name=~\"$job\"}[$__range]))) > 0)",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No data",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.05
              },
              {
                "color": "red",
                "value": 0.2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "p95 job duration",
      "description": "Question: How long do the slowest 5% of jobs take? Default buckets are coarse above 1 hour.\nMetrics: Tier A: emitted by gh-aw.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (increase(gh_aw_job_duration_seconds_bucket{gh_aw_workflow_name=~\"$workflow\", gh_aw_job_name=~\"$job\", gh_aw_engine_id=~\"$engine\", cicd_pipeline_task_run_result=~\"$result\"}[$__range])))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Safe-output items",
      "description": "Question: How many safe-output items (comments, PRs, labels, ...) did workflows produce?\nMetrics: Tier A: emitted by gh-aw.\nIgnores variables: engine, result.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "refId": "A",
          "expr": "sum (increase(gh_aw_workflow_output_items_total{gh_aw_workflow_name=~\"$workflow\", gh_aw_job_name=~\"$job\"}[$__range]))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "Failure rate by workflow (top 10)",
      "description": "Question: Which workflows fail most often? Click a bar to open the workflow in GitHub Actions.\nMetrics: Tier A: emitted by gh-aw.\nIgnores variables: engine, model, result (counters in the ratio do not all carry them).",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 10,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "refId": "A",
          "expr": "topk(10, (sum by (gh_aw_workflow_name) (increase(gh_aw_job_errors_total{gh_aw_workflow_name=~\"$workflow\", gh_aw_job_name=~\"$job\"}[$__range]))) / ((sum by (gh_aw_workflow_name) (increase(gh_aw_job_duration_seconds_count{gh_aw_workflow_name=~\"$workflow\", gh_aw_job_name=~\"$job\"}[$__range]))) > 0))",
          "legendFormat": "{{gh_aw_workflow_name}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "max": 1,
          "links": [
            {
              "title": "Open this workflow in GitHub Actions",
              "url": "https://github.com/${gh_repo}/actions?query=workflow:\"${__field.labels.gh_aw_workflow_name}\"",
              "targetBlank": true
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Job duration p50 / p95",
      "description": "Question: Is job duration drifting up or spiking?\nMetrics: Tier A: emitted by gh-aw.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 10,
        "y": 5,
        "w": 14,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(gh_aw_job_duration_seconds_bucket{gh_aw_workflow_name=~\"$workflow\", gh_aw_job_name=~\"$job\", gh_aw_engine_id=~\"$engine\", cicd_pipeline_task_run_result=~\"$result\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "instant": false,
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gh_aw_job_duration_seconds_bucket{gh_aw_workflow_name=~\"$workflow\", gh_aw_job_name=~\"$job\", gh_aw_engine_id=~\"$engine\", cicd_pipeline_task_run_result=~\"$result\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "row",
      "title": "Supplemental",
      "collapsed": true,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 1
      },
      "panels": [
        {
          "id": 8,
          "type": "timeseries",
          "title": "Jobs per hour by result",
          "description": "Question: What is the throughput, and how does the result mix change over time?\nMetrics: Tier A: emitted by gh-aw.",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "gridPos": {
            "x": 0,
            "y": 15,
            "w": 12,
            "h": 8
          },
          "targets": [
            {
              "datasource": {
                "type": "prometheus",
                "uid": "${ds}"
              },
              "refId": "A",
              "expr": "sum by (cicd_pipeline_task_run_result) (rate(gh_aw_job_duration_seconds_count{gh_aw_workflow_name=~\"$workflow\", gh_aw_job_name=~\"$job\", gh_aw_engine_id=~\"$engine\", cicd_pipeline_task_run_result=~\"$result\"}[$__rate_interval])) * 3600",
              "legendFormat": "{{cicd_pipeline_task_run_result}}",
              "instant": false,
              "range": true
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "noValue": "No data",
              "color": {
                "mode": "palette-classic"
              },
              "custom": {
                "drawStyle": "line",
                "lineWidth": 1,
                "fillOpacity": 20,
                "showPoints": "never",
                "spanNulls": false,
                "stacking": {
                  "mode": "normal",
                  "group": "A"
                }
              }
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          }
        },
        {
          "id": 9,
          "type": "timeseries",
          "title": "Safe-output items by type",
          "description": "Question: What kinds of output are workflows producing?\nMetrics: Tier A: emitted by gh-aw.\nIgnores variables: engine, result.",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "gridPos": {
            "x": 12,
            "y": 15,
            "w": 12,
            "h": 8
          },
          "targets": [
            {
              "datasource": {
                "type": "prometheus",
                "uid": "${ds}"
              },
              "refId": "A",
              "expr": "sum by (gh_aw_safe_output_type) (rate(gh_aw_workflow_output_items_total{gh_aw_workflow_name=~\"$workflow\", gh_aw_job_name=~\"$job\"}[$__rate_interval])) * 3600",
              "legendFormat": "{{gh_aw_safe_output_type}}",
              "instant": false,
              "range": true
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "noValue": "No data",
              "color": {
                "mode": "palette-classic"
              },
              "custom": {
                "drawStyle": "line",
                "lineWidth": 1,
                "fillOpacity": 20,
                "showPoints": "never",
                "spanNulls": false,
                "stacking": {
                  "mode": "normal",
                  "group": "A"
                }
              }
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          }
        },
        {
          "id": 10,
          "type": "table",
          "title": "Workflows overview",
          "description": "Question: Per-workflow jobs, failures and p95 duration in the selected range. Click a workflow to open it in GitHub Actions.\nMetrics: Tier A: emitted by gh-aw.\nIgnores variables: engine, model, result (counters in the ratio do not all carry them).",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "gridPos": {
            "x": 0,
            "y": 23,
            "w": 24,
            "h": 8
          },
          "targets": [
            {
              "datasource": {
                "type": "prometheus",
                "uid": "${ds}"
              },
              "refId": "A",
              "expr": "sum by (gh_aw_workflow_name) (increase(gh_aw_job_duration_seconds_count{gh_aw_workflow_name=~\"$workflow\", gh_aw_job_name=~\"$job\"}[$__range]))",
              "legendFormat": "__auto",
              "instant": true,
              "range": false,
              "format": "table"
            },
            {
              "datasource": {
                "type": "prometheus",
                "uid": "${ds}"
              },
              "refId": "B",
              "expr": "sum by (gh_aw_workflow_name) (increase(gh_aw_job_errors_total{gh_aw_workflow_name=~\"$workflow\", gh_aw_job_name=~\"$job\"}[$__range]))",
              "legendFormat": "__auto",
              "instant": true,
              "range": false,
              "format": "table"
            },
            {
              "datasource": {
                "type": "prometheus",
                "uid": "${ds}"
              },
              "refId": "C",
              "expr": "histogram_quantile(0.95, sum by (le, gh_aw_workflow_name) (increase(gh_aw_job_duration_seconds_bucket{gh_aw_workflow_name=~\"$workflow\", gh_aw_job_name=~\"$job\"}[$__range])))",
              "legendFormat": "__auto",
              "instant": true,
              "range": false,
              "format": "table"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "noValue": "No data",
              "color": {
                "mode": "palette-classic"
              },
              "links": [
                {
                  "title": "Open this workflow in GitHub Actions",
                  "url": "https://github.com/${gh_repo}/actions?query=workflow:\"${__data.fields.gh_aw_workflow_name}\"",
                  "targetBlank": true
                }
              ]
            },
            "overrides": [
              {
                "matcher": {
                  "id": "byName",
                  "options": "p95 duration"
                },
                "properties": [
                  {
                    "id": "unit",
                    "value": "s"
                  }
                ]
              }
            ]
          },
          "options": {
            "showHeader": true,
            "cellHeight": "sm",
            "sortBy": [
              {
                "displayName": "Jobs",
                "desc": true
              }
            ]
          },
          "transformations": [
            {
              "id": "merge",
              "options": {}
            },
            {
              "id": "organize",
              "options": {
                "excludeByName": {
                  "Time": true
                },
                "renameByName": {
                  "Value #A": "Jobs",
                  "Value #B": "Failures",
                  "Value #C": "p95 duration"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
